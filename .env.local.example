# Copy this file to .env.local and add your keys. Never commit .env.local.

# Database (required for backend API). SQLite for local; use Postgres URL in production.
DATABASE_URL="file:./prisma/dev.db"

# Optional: AI chat
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Stripe: link your account for "Send invoice" and client payments
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Required for recording "Paid" in invoice activity (create at https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=

# Optional: send invoice emails from the platform (instead of opening your email client)
# Get key at https://resend.com/
RESEND_API_KEY=

# Slack Integration: create tasks from Slack messages
# Create a Slack app at https://api.slack.com/apps
NEXT_PUBLIC_SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# Your app's public URL (required for Slack OAuth redirect)
NEXT_PUBLIC_APP_URL=http://localhost:3000
